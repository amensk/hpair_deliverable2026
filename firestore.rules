rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(data) { return signedIn() && data.userId == request.auth.uid; }
    function str(field, max) {
      return field is string && field.size() <= max;
    }

    match /formSubmissions/{id} {
      // Any signed-in delegate can read (the /admin table needs this in the demo).
      allow read: if signedIn();

      // Delegates may only create submissions stamped with their own uid, with
      // sane field types and sizes. The CV payload never lives on this document.
      allow create: if isOwner(request.resource.data)
        && str(request.resource.data.firstName, 80)
        && str(request.resource.data.lastName, 80)
        && str(request.resource.data.email, 254)
        && str(request.resource.data.statement, 1000)
        && str(request.resource.data.addressLine1, 200)
        && (!('cvData' in request.resource.data))
        && request.resource.data.consentGiven == true
        && request.resource.data.privacyAccepted == true;

      // Submissions are immutable once sent.
      allow update, delete: if false;

      // Inline CV file (base64 data URL), written in the same batch as the parent.
      match /files/{file} {
        allow read: if signedIn();
        allow create: if isOwner(request.resource.data)
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && getAfter(/databases/$(database)/documents/formSubmissions/$(id)).data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
